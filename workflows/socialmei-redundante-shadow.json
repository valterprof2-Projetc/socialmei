    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = $json.body ?? $json;\nconst messages = [];\nfor (const entry of (body.entry || [])) {\n  for (const event of (entry.messaging || [])) {\n    if (event.message?.is_echo) continue;\n    if (!event.message?.mid || typeof event.message.text !== \"string\" || !event.message.text.trim()) continue;\n    messages.push({channel:\"instagram\",account_ref:\"instagram:\"+String(event.recipient?.id || entry.id),contact_ref:\"instagram:\"+String(event.sender?.id || \"\"),external_message_id:String(event.message.mid),text:event.message.text,contact_name:\"Contato Instagram\",occurred_at:event.timestamp?new Date(Number(event.timestamp)).toISOString():new Date().toISOString(),customer:{name:\"Contato Instagram\"}});\n  }\n}\nif (!messages.length) return [{json:{ignored:true,reason:\"Nenhuma mensagem textual recebida.\"}}];\nif (messages.length > 1) throw new Error(\"O lote Meta contém mais de uma mensagem. Encaminhamento em lote será habilitado antes de ativar este canal.\");\nconst m=messages[0];\nif (!/^instagram:[0-9]{1,40}$/.test(m.account_ref)||!/^instagram:[0-9]{1,40}$/.test(m.contact_ref)) throw new Error(\"IDs de conta/contato Instagram inválidos.\");\nreturn [{json:m}];"
      },
