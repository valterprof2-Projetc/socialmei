      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const event = $json.body?.event ?? $json.event ?? \"\";\nconst p = $json.body?.payload ?? $json.payload ?? {};\nconst data = p._data ?? {};\nif (p.fromMe === true || data.fromMe === true) return [{json:{ignored:true,reason:\"Mensagem enviada pela própria conta WAHA.\"}}];\nif (!p.id || !p.from || typeof p.body !== \"string\" || !p.body.trim()) {\n  throw new Error(\"Evento WAHA sem ID, remetente ou texto; nenhuma mensagem foi enviada ao CRM.\");\n}\nif (event && !String(event).toLowerCase().includes(\"message\")) return [{json:{ignored:true,reason:\"Evento WAHA não é mensagem.\"}}];\nconst accountRef = String($vars.SOCIALMEI_WAHA_ACCOUNT_REF || \"\");\nif (!/^waha:[0-9]{1,40}@c\\.us$/.test(accountRef)) throw new Error(\"Configure a variável SOCIALMEI_WAHA_ACCOUNT_REF no n8n.\");\nconst rawFrom = String(p.from);\nconst contactRef = rawFrom.includes(\"@lid\") ? \"waha:\" + rawFrom : \"waha:\" + rawFrom;\nconst externalId = typeof p.id === \"string\" ? p.id : (p.id._serialized || p.id.id || \"\");\nif (!externalId) throw new Error(\"ID externo WAHA não reconhecido.\");\nreturn [{json:{\n channel:\"whatsapp\",account_ref:accountRef,contact_ref:contactRef,\n external_message_id:externalId,text:p.body,\n contact_name:data.Info?.PushName || data.pushName || p.notifyName || \"Cliente\",\n occurred_at:p.timestamp ? new Date(Number(p.timestamp)*1000).toISOString() : new Date().toISOString(),\n customer:{name:data.Info?.PushName || data.pushName || p.notifyName || \"Cliente\",phone:rawFrom.endsWith(\"@c.us\")?rawFrom.split(\"@\")[0]:null}\n}}];"
      },
