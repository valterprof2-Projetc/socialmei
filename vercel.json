{
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api/v1?path=:path*"
    },
    {
      "source": "/api/financeiro/:path*",
      "destination": "/api/financeiro?route=:path*"
    },
    {
      "source": "/api/integrations/:route*",
      "destination": "/api/integrations?route=:route*"
    }
  ]
}
